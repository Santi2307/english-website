# URL pública del sitio (canonical, Open Graph)
VITE_SITE_URL=http://localhost:5173
# Wompi: el widget solo necesita la llave pública, que llega desde el backend al crear la orden.
# Google Identity Services (mismo Client ID que el backend)
VITE_GOOGLE_CLIENT_ID=
# Analítica (opcionales)
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
# WhatsApp en formato internacional sin "+" (ej. 573001234567)
VITE_WHATSAPP_NUMBER=573001234567
