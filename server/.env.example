# ─── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Proxies delante de la app: 1 en local/Render directo, 2 con Vercel (rewrite) → Render
TRUST_PROXY=1
# URL pública del frontend (CORS, redirecciones, emails)
CLIENT_URL=http://localhost:5173
# URL pública del backend (sitemap, links absolutos)
API_URL=http://localhost:4000

# ─── Base de datos ───────────────────────────────────────────
# Local: Docker. Producción: Neon → Connection string directa (no "pooled"). Si Prisma la rechaza, quita "&channel_binding=require"
DATABASE_URL=postgresql://neondb_owner:npg_oqsMmlV6J1PL@ep-autumn-tooth-b4p71vhi.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── Autenticación ───────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# Lax si el frontend proxya /api (recomendado). None si front y back están en dominios distintos.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Google Identity Services (OAuth Client ID tipo "Web")
GOOGLE_CLIENT_ID=

# ─── Wompi ───────────────────────────────────────────────────
# sandbox | production
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Video (bunny | mux | none) ──────────────────────────────
VIDEO_PROVIDER=none
VIDEO_URL_TTL_SECONDS=3600
# Bunny Stream: Library ID + "Token Authentication Key" de la librería
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=
# Mux: signing key (ID + private key en base64)
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# ─── Email ───────────────────────────────────────────────────
# preview: no envía nada; guarda cada email en EMAIL_PREVIEW_DIR (recomendado en local)
# sandbox: envía por Resend SOLO a EMAIL_SANDBOX_ALLOWLIST; el resto va a preview (staging)
# live:    envía a todos. El servidor se niega a arrancar con live si NODE_ENV != production
EMAIL_MODE=preview
# brevo (gratis, 300/día, sin dominio propio) | resend (requiere dominio verificado)
EMAIL_PROVIDER=brevo
EMAIL_FROM="English Academy <hola@tudominio.com>"
EMAIL_REPLY_TO=soporte@tudominio.com
SUPPORT_EMAIL=soporte@tudominio.com
EMAIL_SANDBOX_ALLOWLIST=tu-email@gmail.com
EMAIL_PREVIEW_DIR=.email-previews
# Brevo → SMTP & API → API Keys (xkeysib-...)
BREVO_API_KEY=
# Token secreto para la URL del webhook de Brevo: .../api/webhooks/brevo?token=ESTE_VALOR
BREVO_WEBHOOK_TOKEN=
RESEND_API_KEY=
# Resend → Webhooks → Signing secret (whsec_...). Registra delivered/bounced en el log.
RESEND_WEBHOOK_SECRET=
# Cada cuánto el worker revisa reintentos pendientes en la BD (minutos)
NOTIFICATIONS_SWEEP_MINUTES=60

# ─── Seed ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@englishacademy.co
SEED_ADMIN_PASSWORD=Admin12345!
