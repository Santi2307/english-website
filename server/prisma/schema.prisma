generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum CourseLevel {
  A1
  A2
  B1
  B2
  C1
}

enum CourseGoal {
  CONVERSATION
  BUSINESS
  EXAM
  KIDS
}

enum CourseBadge {
  BESTSELLER
  NEW
}

enum OrderStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

enum CouponType {
  PERCENT
  FIXED
}

model User {
  id              String                  @id @default(cuid())
  email           String                  @unique
  name            String
  passwordHash    String?
  googleId        String?                 @unique
  avatarUrl       String?
  role            Role                    @default(STUDENT)
  // Idioma para comunicaciones (es | en)
  locale          String                  @default("es")
  /// Zona horaria IANA del navegador (p. ej. "Asia/Kabul"); null si nunca se conoció
  timeZone        String?
  emailVerifiedAt DateTime?
  // Se incrementa al cambiar la contraseña: invalida todas las sesiones (JWT) emitidas antes
  sessionVersion  Int                     @default(0)
  // Racha de días consecutivos con al menos una lección completada
  streakCount     Int                     @default(0)
  lastActiveDate  DateTime?               @db.Date
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  orders          Order[]
  enrollments     Enrollment[]
  progress        LessonProgress[]
  reviews         Review[]
  tokens          AuthToken[]
  devices         KnownDevice[]
  notifications   Notification[]
  preferences     NotificationPreference?
}

model Course {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  subtitle         String
  description      String
  level            CourseLevel
  goal             CourseGoal
  // Precio en pesos colombianos (sin centavos). Wompi recibe priceCOP * 100.
  priceCOP         Int
  // Precio "antes" para mostrar descuento tachado
  compareAtCOP     Int?
  badge            CourseBadge?
  coverImage       String?
  // Color base para portadas generadas cuando no hay imagen
  coverColor       String       @default("#4f46e5")
  // URL de embed pública (trailer). No requiere inscripción.
  previewVideoUrl  String?
  durationHours    Int          @default(0)
  instructorName   String
  instructorBio    String
  instructorAvatar String?
  whatYouLearn     String[]
  published        Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  modules          Module[]
  orders           Order[]
  enrollments      Enrollment[]
  reviews          Review[]
  coupons          Coupon[]

  @@index([published, level, goal])
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  position Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id              String           @id @default(cuid())
  moduleId        String
  title           String
  description     String           @default("")
  position        Int
  durationMinutes Int              @default(5)
  // ID del video en el proveedor (Bunny videoId o Mux playbackId). Nunca se expone sin firmar.
  videoId         String?
  // Lecciones gratuitas visibles en el temario sin comprar
  isFreePreview   Boolean          @default(false)
  // Contenido interactivo (mini-clase, vocabulario, gramática, diálogo, ejercicios). Validado con Zod en src/lessonContent.
  content         Json?
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]

  @@index([moduleId, position])
}

model Order {
  id                 String      @id @default(cuid())
  // Referencia única enviada a Wompi
  reference          String      @unique
  userId             String
  courseId           String
  status             OrderStatus @default(PENDING)
  subtotalCOP        Int
  discountCOP        Int         @default(0)
  amountInCents      Int
  currency           String      @default("COP")
  couponId           String?
  wompiTransactionId String?     @unique
  paymentMethod      String?
  statusMessage      String?
  paidAt             DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id])
  course             Course      @relation(fields: [courseId], references: [id])
  coupon             Coupon?     @relation(fields: [couponId], references: [id])
  enrollment         Enrollment?

  @@index([userId, status])
  @@index([status, createdAt])
}

model Enrollment {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  orderId         String?   @unique
  completedAt     DateTime?
  certificateCode String?   @unique
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order           Order?    @relation(fields: [orderId], references: [id])

  // Garantiza idempotencia: un usuario no puede inscribirse dos veces al mismo curso
  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  // % de aciertos en los ejercicios de la lección (si los hizo)
  score       Int?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  // PERCENT: 1-100. FIXED: pesos COP.
  value          Int
  // Si es null aplica a todos los cursos
  courseId       String?
  maxRedemptions Int?
  redemptions    Int        @default(0)
  expiresAt      DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  course         Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  orders         Order[]
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// Registro de auditoría de eventos de Wompi. El eventKey único evita reprocesar duplicados.
model PaymentEvent {
  id            String   @id @default(cuid())
  eventKey      String   @unique
  reference     String
  transactionId String
  status        String
  payload       Json
  createdAt     DateTime @default(now())

  @@index([reference])
}

// ─── Tokens de un solo uso (verificación de email, reset de contraseña) ─────
enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  // SHA-256 del token. El token en claro solo existe en el link del email.
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Dispositivos desde los que el usuario ya inició sesión (para alertas de nuevo inicio)
model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  // SHA-256 de navegador + sistema operativo. No se guarda el user-agent completo.
  fingerprint String
  label       String
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
}

// ─── Notificaciones ──────────────────────────────────────────────────────────
enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  // No se envió por preferencias del usuario o destinatario suprimido
  SKIPPED
}

enum NotificationCategory {
  SECURITY
  TRANSACTIONAL
  ACCOUNT
  PRODUCT_UPDATES
  TIPS
  MARKETING
}

model Notification {
  id                String               @id @default(cuid())
  userId            String?
  channel           String
  // Destinatario del canal (email). Necesario para reintentos y soporte.
  recipient         String
  eventType         String
  eventId           String
  template          String
  category          NotificationCategory
  // Evita duplicados: "<EVENTO>:<eventId>:<canal>"
  idempotencyKey    String               @unique
  status            NotificationStatus   @default(QUEUED)
  provider          String?
  providerMessageId String?              @unique
  // Datos NO sensibles para re-renderizar en un reintento
  payload           Json
  attempts          Int                  @default(0)
  nextAttemptAt     DateTime             @default(now())
  errorMessage      String?
  createdAt         DateTime             @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([recipient])
}

model NotificationPreference {
  userId             String    @id
  accountUpdates     Boolean   @default(true)
  productUpdates     Boolean   @default(true)
  tips               Boolean   @default(true)
  // Marketing requiere consentimiento explícito (Ley 1581 de 2012): desactivado por defecto
  marketing          Boolean   @default(false)
  marketingConsentAt DateTime?
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
